---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import BookShelf from "@/components/BookShelf.astro";
import config from "@/config";

const title = `${config.site.title} · 知识分享`;
---

<Layout title={title} description="知识分享阅读器：左侧目录，右侧内容">
  <Header wide />
  <main id="main-content" class="reader-page my-1">
    <div class="reader-topbar">
      <button id="reader-menu-btn" class="reader-menu-btn" type="button" aria-label="打开目录">
        ☰ 目录
      </button>
      <span class="reader-topbar-title">{config.site.title} · 知识分享</span>
    </div>

    <div class="reader-layout">
      <aside id="reader-toc" class="reader-toc">
        <BookShelf />
        <nav id="toc-list" class="reader-toc-list" aria-label="章节目录"></nav>
      </aside>

      <article
        id="reader-content"
        class="reader-content"
        aria-live="polite"
      >
        <p class="reader-status">加载中 …</p>
      </article>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import "@/scripts/reader/app";
</script>

<style is:global>
  /* ============ 阅读器布局（specs/002-knowledge-home） ============ */
  /* 全宽容器：脱出主题 max-w-3xl 窄栏（修复“未占满全屏”） */
  .reader-page {
    max-width: none;
    width: 100%;
    padding-inline: clamp(1rem, 3vw, 2.5rem);
  }
  .reader-topbar {
    display: none;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .reader-topbar-title {
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }
  .reader-menu-btn {
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    padding: 0.25rem 0.625rem;
    font-size: 0.875rem;
    color: var(--foreground);
    background: var(--background);
    cursor: pointer;
  }

  /* 视口高度布局：目录与内容各自内滚，页脚退到第二屏 */
  .reader-layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 1.5rem;
    height: calc(100dvh - 7.5rem);
    min-height: 30rem;
    padding: 1rem 0 0.5rem;
  }

  /* ---- 左：书架 + 目录 ---- */
  .reader-toc {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow-y: auto;
    padding-right: 0.25rem;
  }
  .reader-shelf-label,
  .reader-toc-list::before {
    display: block;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.375rem;
  }
  .reader-shelf-list {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .reader-book {
    text-align: left;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: var(--background);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .reader-book:hover {
    border-color: var(--accent);
  }
  .reader-book.active {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--background));
  }
  .reader-book-title {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--foreground);
  }
  .reader-book-desc {
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  .reader-toc-list {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0;
    border-top: 1px solid var(--border);
  }
  .reader-toc-item {
    display: block;
    padding: 0.3125rem 0.5rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    color: var(--muted-foreground);
    line-height: 1.4;
  }
  .reader-toc-item:hover {
    color: var(--foreground);
    background: var(--muted);
  }
  .reader-toc-item.active {
    color: var(--accent);
    font-weight: 600;
    background: color-mix(in srgb, var(--accent) 8%, var(--background));
  }
  .reader-toc-item.depth-1 { padding-left: 1.25rem; }
  .reader-toc-item.depth-2 { padding-left: 2rem; }
  .reader-toc-item.depth-3 { padding-left: 2.75rem; }

  /* ---- 右：内容 ---- */
  .reader-content {
    overflow-y: auto;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 1.5rem 2rem 3rem;
  }
  .reader-content-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .reader-content-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--foreground);
  }
  .reader-source-link {
    flex-shrink: 0;
    font-size: 0.8125rem;
    color: var(--muted-foreground);
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 4px;
  }
  .reader-source-link:hover {
    color: var(--accent);
  }

  .reader-status {
    color: var(--muted-foreground);
    padding: 1rem 0;
  }
  .reader-error {
    color: var(--foreground);
  }
  .reader-error code {
    background: var(--muted);
    padding: 0.1em 0.4em;
    border-radius: 0.25rem;
  }
  .reader-status-sub {
    color: var(--muted-foreground);
    font-size: 0.875rem;
    margin-top: 0.5rem;
  }
  .reader-empty {
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  /* ---- 正文 markdown 排版 ---- */
  .reader-markdown {
    color: var(--foreground);
    font-size: 0.9375rem;
    line-height: 1.75;
    word-break: break-word;
  }
  .reader-markdown h1,
  .reader-markdown h2,
  .reader-markdown h3,
  .reader-markdown h4 {
    color: var(--foreground);
    font-weight: 700;
    margin: 1.75em 0 0.6em;
    line-height: 1.3;
  }
  .reader-markdown h1 { font-size: 1.5rem; }
  .reader-markdown h2 {
    font-size: 1.25rem;
    padding-bottom: 0.3em;
    border-bottom: 1px solid var(--border);
  }
  .reader-markdown h3 { font-size: 1.0625rem; }
  .reader-markdown p { margin: 0.75em 0; }
  .reader-markdown a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .reader-markdown ul,
  .reader-markdown ol {
    padding-left: 1.5em;
    margin: 0.75em 0;
  }
  .reader-markdown ul { list-style: disc; }
  .reader-markdown ol { list-style: decimal; }
  .reader-markdown li { margin: 0.25em 0; }
  .reader-markdown blockquote {
    border-left: 3px solid var(--accent);
    padding: 0.25em 1em;
    margin: 1em 0;
    color: var(--muted-foreground);
  }
  .reader-markdown code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.875em;
    background: var(--muted);
    padding: 0.15em 0.4em;
    border-radius: 0.3rem;
  }
  .reader-markdown pre {
    background: var(--muted);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin: 1em 0;
  }
  .reader-markdown pre code {
    background: transparent;
    padding: 0;
    font-size: 0.8125rem;
    line-height: 1.6;
  }
  .reader-markdown img {
    max-width: 100%;
    height: auto;
    border-radius: 0.375rem;
  }
  .reader-markdown table {
    width: 100%;
    border-collapse: collapse;
    margin: 1em 0;
    font-size: 0.875rem;
    display: block;
    overflow-x: auto;
  }
  .reader-markdown th,
  .reader-markdown td {
    border: 1px solid var(--border);
    padding: 0.4em 0.75em;
    text-align: left;
  }
  .reader-markdown th {
    background: var(--muted);
    font-weight: 600;
  }
  .reader-markdown hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2em 0;
  }

  /* ---- 移动端（FR-008）：目录折叠为抽屉，恢复正常文档流 ---- */
  @media (max-width: 768px) {
    .reader-topbar { display: flex; }
    .reader-page { padding-inline: 1rem; }
    .reader-layout {
      grid-template-columns: 1fr;
      gap: 1rem;
      position: relative;
      height: auto;
      min-height: 0;
      padding: 0.75rem 0 2rem;
    }
    .reader-content { overflow-y: visible; }
    .reader-toc {
      position: fixed;
      inset-block: 0;
      left: 0;
      width: min(80vw, 320px);
      max-height: none;
      background: var(--background);
      padding: 1rem;
      border-inline-end: 1px solid var(--border);
      z-index: 60;
      transform: translateX(-100%);
      transition: transform 0.2s ease;
      box-shadow: 0 0 2rem rgb(0 0 0 / 0.15);
    }
    .reader-toc.open { transform: translateX(0); }
    .reader-content { padding: 1.25rem 1rem 2rem; }
  }
</style>
